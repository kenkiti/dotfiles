{{- /* Managed by chezmoi. Edit with: chezmoi edit ~/.zprofile
       Login-shell environment only. Interactive settings live in ~/.zshrc. */ -}}
# ===========================================================================
# ~/.zprofile - login shell environment
# ===========================================================================

# --- Locale ----------------------------------------------------------------
export LANG={{ .defaults.zsh.lang | quote }}

# --- PATH ------------------------------------------------------------------
# Prepend only directories that actually exist, so a missing tool never leaves
# a dangling PATH entry.
for _dir in "$HOME/.local/bin" "$HOME/bin"; do
  [[ -d "$_dir" ]] && PATH="$_dir:$PATH"
done
unset _dir
export PATH

# --- Version managers ------------------------------------------------------
# Each block is a no-op when the manager is not installed.
if [[ -d "$HOME/.rbenv/bin" ]]; then
  export PATH="$HOME/.rbenv/bin:$PATH"
fi
if command -v rbenv >/dev/null 2>&1; then
  eval "$(rbenv init - zsh)"
fi

if [[ -d "$HOME/.nodenv/bin" ]]; then
  export PATH="$HOME/.nodenv/bin:$PATH"
fi
if command -v nodenv >/dev/null 2>&1; then
  eval "$(nodenv init - zsh)"
fi

{{ if .isWSL -}}
# --- WSL -------------------------------------------------------------------
# Keep Windows PATH entries out of the way but still reachable; without this
# every `ls` completion has to stat the whole Windows PATH over 9p.
export BROWSER="wslview"
{{ end -}}

# --- Machine-local overrides ----------------------------------------------
# ~/.zprofile.local is NOT managed by chezmoi and NOT committed.
# Put secrets, API tokens and per-machine paths there. See docs/SECRETS.md.
[[ -f "$HOME/.zprofile.local" ]] && source "$HOME/.zprofile.local"

true
