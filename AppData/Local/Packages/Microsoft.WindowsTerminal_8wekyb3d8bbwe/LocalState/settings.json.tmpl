{{- $host := default (dict) (get .hosts .chezmoi.hostname) -}}
{{- $cfg := mergeOverwrite (deepCopy .defaults) $host -}}
{{- $wt := $cfg.windowsTerminal -}}
{
    "$help": "https://aka.ms/terminal-documentation",
    "$schema": "https://aka.ms/terminal-profiles-schema",

    "actions": [],

    "copyFormatting": "none",
    "copyOnSelect": {{ $wt.copyOnSelect }},

    "defaultProfile": "{{ $wt.defaultProfileGuid }}",

    "keybindings": [
        { "id": "Terminal.MoveFocusNextInOrder", "keys": "ctrl+shift+o" },
        { "id": "Terminal.SplitPaneDown",        "keys": "ctrl+shift+2" },
        { "id": "Terminal.SplitPaneRight",       "keys": "ctrl+shift+3" },
        { "id": "Terminal.ClosePane",            "keys": "ctrl+shift+0" },
        { "id": "Terminal.DuplicatePaneAuto",    "keys": "alt+shift+d" },

        { "id": "Terminal.CopyToClipboard",   "keys": "ctrl+c" },
        { "id": "Terminal.PasteFromClipboard","keys": "ctrl+v" },
        { "id": "Terminal.FindText",          "keys": "ctrl+shift+f" },

        { "id": null, "keys": "alt+up" },
        { "id": null, "keys": "alt+down" },
        { "id": null, "keys": "alt+left" },
        { "id": null, "keys": "alt+right" }
    ],

    "newTabMenu": [
        { "type": "remainingProfiles" }
    ],

    "profiles": {
        "defaults": {
            "startingDirectory": {{ $wt.startingDirectory | toJson }},
            "colorScheme": {{ $wt.colorScheme | toJson }},
            "font": {
                "face": {{ $wt.fontFace | toJson }},
                "size": {{ $wt.fontSize }}
            }
        },
        "list": [
            {
                "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
                "hidden": false
            },
            {
                "guid": "{{ $wt.defaultProfileGuid }}",
                "hidden": false
            }
        ]
    },

    "schemes": [],
    "themes": []
}
