{{- /* Managed by chezmoi. Edit with: chezmoi edit ~/.zshrc

       Layering, from top to bottom:
         1. common zsh behaviour (history, completion, keybindings)
         2. Ubuntu / Linux specifics
         3. WSL specifics
         4. host specifics (driven by .chezmoidata.yaml)
         5. ~/.zshrc.local - never committed, never managed by chezmoi
    */ -}}
{{- $host := default (dict) (get .hosts .chezmoi.hostname) -}}
{{- $cfg := mergeOverwrite (deepCopy .defaults) $host -}}
# ===========================================================================
# ~/.zshrc - interactive shell configuration
# ===========================================================================

{{ if and $cfg.zsh.ohMyZsh $cfg.zsh.powerlevel10k -}}
# Powerlevel10k instant prompt. Keep this near the top; anything that may ask
# for input must be placed above it.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi
{{ end -}}

# Nothing below is useful in a non-interactive shell (scp, rsync, ...).
[[ $- != *i* ]] && return

{{ if $cfg.zsh.ohMyZsh -}}
# ---------------------------------------------------------------------------
# Oh My Zsh
#
# Loaded only when it is actually installed, so a fresh machine gets a working
# shell before the installer has run.
# ---------------------------------------------------------------------------
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
if [[ -d "$ZSH" ]]; then
  ZSH_THEME={{ $cfg.zsh.ohMyZshTheme | quote }}
  plugins=({{ range $i, $p := $cfg.zsh.ohMyZshPlugins }}{{ if $i }} {{ end }}{{ $p }}{{ end }})

  # Custom themes/plugins may be kept outside ~/.oh-my-zsh so that upgrading
  # Oh My Zsh never touches them.
  [[ -d "$HOME/.oh-my-zsh-custom" ]] && ZSH_CUSTOM="$HOME/.oh-my-zsh-custom"

  source "$ZSH/oh-my-zsh.sh"
fi
{{ end -}}

{{ if and $cfg.zsh.ohMyZsh $cfg.zsh.powerlevel10k -}}
# Generated locally by `p10k configure`. It is optional so the shell remains
# usable before Powerlevel10k has been configured on a new machine.
[[ -r "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"
{{ end -}}

# ---------------------------------------------------------------------------
# Completion
# ---------------------------------------------------------------------------
autoload -Uz compinit
compinit

setopt list_packed          # compact completion list
setopt nolistbeep           # no beep when the completion list is shown
setopt correct              # offer corrections for mistyped commands

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# ---------------------------------------------------------------------------
# Directory navigation
# ---------------------------------------------------------------------------
setopt auto_cd              # `..` instead of `cd ..`
setopt auto_pushd           # keep a directory stack; `cd -<TAB>` to browse it
setopt pushd_ignore_dups

# ---------------------------------------------------------------------------
# History
# ---------------------------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=100000

setopt hist_ignore_dups         # drop a command duplicated back to back
setopt hist_ignore_all_dups     # drop older duplicates anywhere in history
setopt hist_expire_dups_first
setopt share_history            # share history between running shells
setopt inc_append_history       # append as each command runs, not on exit
setopt bang_hist
setopt hist_verify              # expand history but let me confirm before running
setopt hist_no_functions        # do not record function definitions
setopt hist_no_store            # do not record the `history` command itself
setopt extended_history         # record timestamps
setopt hist_reduce_blanks

# ---------------------------------------------------------------------------
# Key bindings (Emacs style)
# ---------------------------------------------------------------------------
bindkey -e

# Ctrl-P / Ctrl-N search history for what has already been typed.
autoload -Uz history-search-end
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end
bindkey "^P" history-beginning-search-backward-end
bindkey "^N" history-beginning-search-forward-end

# Make Ctrl-W stop at punctuation, the way Emacs does.
WORDCHARS="*?_-.[]~=&!#$%^(){}<>"

{{ if not $cfg.zsh.ohMyZsh -}}
# ---------------------------------------------------------------------------
# Prompt (only when Oh My Zsh is not providing one)
# ---------------------------------------------------------------------------
autoload -Uz colors && colors
setopt prompt_subst
case ${UID} in
  0) PROMPT='%F{red}%/#%f ' ;;
  *) PROMPT='%F{yellow}%/%%%f ' ;;
esac
PROMPT2='%F{red}%_%%%f '
SPROMPT='%F{red}%r is correct? [n,y,a,e]:%f '
# Show host when connected over SSH.
[[ -n "${SSH_CONNECTION}${REMOTEHOST}" ]] && PROMPT="%F{white}${HOST%%.*}%f ${PROMPT}"
{{ end -}}

# ---------------------------------------------------------------------------
# Terminal title
# ---------------------------------------------------------------------------
case "${TERM}" in
  xterm*|kterm*|screen*|tmux*)
    precmd() { print -Pn "\e]0;%n@%m:%~\a" }
    ;;
esac

# Emacs' M-x shell reports a TERM zsh does not know how to colour.
[[ $TERM = "eterm-color" ]] && TERM=xterm-color

# ---------------------------------------------------------------------------
# Colours and aliases (GNU coreutils)
# ---------------------------------------------------------------------------
if command -v dircolors >/dev/null 2>&1; then
  eval "$(dircolors -b)"
fi
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

alias ls='ls --color=auto -Fv'
alias ll='ls --color=auto -lFv'
alias la='ls --color=auto -laFv'
alias grep='grep --color=auto'
alias du='du -h'
alias df='df -h'
alias ..='cd ..'
alias ...='cd ../..'

# List the directory after every `cd`, as the previous configuration did.
chpwd() { ll }

export EDITOR={{ $cfg.zsh.editor | quote }}

# ---------------------------------------------------------------------------
# Git shortcuts (mirrors the PowerShell profile so muscle memory carries over)
# ---------------------------------------------------------------------------
alias gs='git status'
alias gd='git diff'
alias gl='git log --oneline --decorate --graph -20'
alias gco='git checkout'
alias gp='git push'
alias gpull='git pull'
gcm() {
  if [[ $# -lt 1 ]]; then
    print -u2 "usage: gcm <message>"
    return 2
  fi
  git add . && git commit -m "$1"
}

{{ if .isLinuxNative -}}
# ---------------------------------------------------------------------------
# Native Linux only
# ---------------------------------------------------------------------------
command -v xdg-open >/dev/null 2>&1 && alias open='xdg-open'
{{ end -}}

{{ if .isWSL -}}
# ---------------------------------------------------------------------------
# WSL only
# ---------------------------------------------------------------------------
# Open the current directory in Windows Explorer.
open() { explorer.exe "${1:-.}" >/dev/null 2>&1 }

# Windows clipboard.
alias pbcopy='clip.exe'
alias pbpaste='powershell.exe -NoProfile -Command Get-Clipboard | tr -d "\r"'

# `cd` into the Windows user profile.
alias cdwin='cd "$(wslpath "$(cmd.exe /c echo %USERPROFILE% 2>/dev/null | tr -d "\r")")"'

# Git on /mnt/* is slow and confuses file modes; warn once instead of silently
# producing bad diffs.
if [[ "$PWD" == /mnt/* ]]; then
  print -u2 "note: working under /mnt (Windows filesystem); git will be slow here"
fi
{{ end -}}

{{ if hasKey $host "zsh" -}}
{{ if hasKey $host.zsh "extraLines" -}}
# ---------------------------------------------------------------------------
# Host-specific ({{ .chezmoi.hostname }}), from .chezmoidata.yaml
# ---------------------------------------------------------------------------
{{ range $host.zsh.extraLines }}{{ . }}
{{ end }}
{{- end }}
{{- end }}

# ---------------------------------------------------------------------------
# Machine-local overrides
#
# ~/.zshrc.local is NOT managed by chezmoi and NOT committed. Secrets, tokens,
# work-only aliases and per-machine paths belong there. See docs/SECRETS.md.
# ---------------------------------------------------------------------------
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"

true
